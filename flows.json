    {
        "id": "store_sensor",
        "type": "function",
        "z": "e5e3cddbfb4e0ca8",
        "name": "Simpan Data Sensor",
        "func": "// Simpan data sensor\nvar data = msg.payload;\ndata.received = new Date().toISOString();\nflow.set('lastSensor', data);\n\n// Simpan history (max 50 data)\nvar history = flow.get('history') || [];\nhistory.push(data);\nif (history.length > 50) history.shift();\nflow.set('history', history);\n\n// Cek batas suhu\nvar threshold = flow.get('threshold');\nvar suhu = Number(data.suhu);\n\nif (threshold && suhu > threshold) {\n    node.warn(\"PERINGATAN! Suhu melewati batas: \" + suhu + \"°C (Batas: \" + threshold + \"°C)\");\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 160,
        "wires": [
            [
                "debug_sensor",
                "af310a4ab28cfde6",
                "b226f09e4e1d2e54"
            ]
        ]
    },
