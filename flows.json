    {
        "id": "ec26b29edf7f1783",
        "type": "function",
        "z": "e5e3cddbfb4e0ca8",
        "name": "Simpan Threshold",
        "func": "// Validasi API Key\nvar apiKey = msg.req.headers['x-api-key'];\n\nif (apiKey !== \"iot-uniska-2026\") {\n    msg.statusCode = 401;\n    msg.payload = {\n        status: \"error\",\n        message: \"API Key tidak valid\"\n    };\n    return msg;\n}\nvar batas = Number(msg.payload.threshold);\n\nif (msg.payload.threshold === undefined || !Number.isFinite(batas) || batas <= 0) {\n    msg.statusCode = 400;\n    msg.payload = {\n        status: \"error\",\n        message: \"Threshold harus berupa angka lebih dari 0\"\n    };\n} else {\n    flow.set(\"threshold\", batas);\n\n    msg.statusCode = 200;\n    msg.payload = {\n        status: \"success\",\n        message: \"Batas suhu berhasil diperbarui\",\n        threshold: batas\n    };\n}\n\nmsg.headers = {\n    \"Access-Control-Allow-Origin\": \"*\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
