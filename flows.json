    {
        "id": "proc_kontrol",
        "type": "function",
        "z": "e5e3cddbfb4e0ca8",
        "name": "Validasi & Publish",
        "func": "// Validasi API Key\nvar apiKey = msg.req.headers['x-api-key'];\n\nif (apiKey !== \"iot-uniska-2026\") {\n    msg.statusCode = 401;\n    msg.payload = {\n        status: \"error\",\n        message: \"API Key tidak valid\"\n    };\n    return [msg, null];\n}\nvar body = msg.payload;\nif (!body.device || !body.action) {\n    msg.statusCode = 400;\n    msg.payload = {status: 'error', message: 'device dan action wajib diisi'};\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    return msg;\n}\n\n// Publish ke MQTT\nvar mqttMsg = {payload: body, topic: 'iot/kontrol'};\nnode.send([null, mqttMsg]);\n\nmsg.statusCode = 200;\nmsg.payload = {\n    status: 'success',\n    message: 'Perintah terkirim',\n    sent: body\n};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn [msg, null];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 420,
        "wires": [
            [
                "http_resp_kontrol"
            ],
            [
                "mqtt_publish_kontrol"
            ]
        ]
    },
